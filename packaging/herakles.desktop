[Desktop Entry]
Type=Application
Name=Herakles
GenericName=Backup
Comment=Deduplicated, encrypted backups of files, disks and Docker projects
Exec=herakles tray --open
Icon=herakles
Terminal=false
Categories=Utility;Archiving;System;
Keywords=backup;restore;snapshot;docker;
Actions=Window;

[Desktop Action Window]
Name=Open the window only (no tray icon)
Exec=herakles gui
