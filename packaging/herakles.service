# Installed by the herakles package. Desktop: `sudo herakles daemon desktop on`
# sets it up and opens it from your "Herakles" menu entry. Server: configure
# /etc/herakles/herakles.yaml (e.g. `sudo herakles tui`), then:
#   sudo systemctl enable --now herakles
[Unit]
Description=Herakles backup daemon: runs scheduled, deduplicated and encrypted backups.
Documentation=https://herakles.kloeck-it.de/guide.html
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/herakles/herakles.yaml

[Service]
ExecStart=/usr/bin/herakles daemon run --config /etc/herakles/herakles.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=120
EnvironmentFile=-/etc/default/herakles
EnvironmentFile=-/etc/sysconfig/herakles
# /run/herakles/desktop: the GUI shared with gui.users ('herakles daemon desktop')
RuntimeDirectory=herakles
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
